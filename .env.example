FASTAPI_ENV=development

PROJECT_NAME="Ship Guard"

# Khoá bí mật dùng để ký JWT token đăng nhập — đổi thành chuỗi ngẫu nhiên, KHÔNG dùng "changethis" ngoài môi trường local
# Sinh nhanh bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changethis

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Chuỗi kết nối Postgres — định dạng postgresql://<user>:<password>@<host>:<port>/<tên_database>
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Cấu hình máy chủ SMTP — dùng để gửi email xác thực, reset mật khẩu, v.v.
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025
